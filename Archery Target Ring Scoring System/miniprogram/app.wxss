/* 射箭记分助手 - 全局样式 */

/* 全局重置样式 */
page {
  background-color: #f8f9fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
  font-size: 16px;
  line-height: 1.6;
  color: #333;
}

/* 容器样式 */
.container {
  padding: 20rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 卡片样式 */
.card {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 20rpx;
  overflow: hidden;
}

.card-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
}

.card-body {
  padding: 30rpx;
}

.card-footer {
  padding: 20rpx 30rpx;
  background: #f8f9fa;
  border-top: 1rpx solid #f0f0f0;
}

/* 按钮样式 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 40rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.btn-primary:active {
  background: linear-gradient(135deg, #5a6fd8 0%, #6a4190 100%);
  transform: scale(0.98);
}

.btn-secondary {
  background: #6c757d;
  color: #fff;
}

.btn-secondary:active {
  background: #5a6268;
  transform: scale(0.98);
}

.btn-success {
  background: linear-gradient(135deg, #56ab2f 0%, #a8e6cf 100%);
  color: #fff;
}

.btn-success:active {
  background: linear-gradient(135deg, #4a9a1f 0%, #96d6b7 100%);
  transform: scale(0.98);
}

.btn-warning {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: #fff;
}

.btn-warning:active {
  background: linear-gradient(135deg, #e681e9 0%, #f3455a 100%);
  transform: scale(0.98);
}

.btn-outline {
  background: transparent;
  border: 2rpx solid #667eea;
  color: #667eea;
}

.btn-outline:active {
  background: #667eea;
  color: #fff;
}

.btn-large {
  padding: 30rpx 60rpx;
  font-size: 32rpx;
  border-radius: 60rpx;
}

.btn-small {
  padding: 15rpx 30rpx;
  font-size: 24rpx;
  border-radius: 40rpx;
}

.btn-block {
  width: 100%;
  display: flex;
}

.btn-disabled {
  opacity: 0.6;
  pointer-events: none;
}

/* 输入框样式 */
.input-group {
  margin-bottom: 30rpx;
}

.input-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 28rpx;
  color: #555;
  font-weight: 500;
}

.input-field {
  width: 100%;
  padding: 25rpx 30rpx;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #fff;
  box-sizing: border-box;
  transition: border-color 0.3s ease;
}

.input-field:focus {
  border-color: #667eea;
  outline: none;
}

.input-field.error {
  border-color: #dc3545;
}

/* 选择器样式 */
.picker-group {
  margin-bottom: 30rpx;
}

.picker-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 28rpx;
  color: #555;
  font-weight: 500;
}

.picker-field {
  width: 100%;
  padding: 25rpx 30rpx;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #fff;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-field::after {
  content: '▼';
  color: #999;
  font-size: 20rpx;
}

/* 列表样式 */
.list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.list-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  transition: background-color 0.3s ease;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item:active {
  background-color: #f8f9fa;
}

.list-item-content {
  flex: 1;
}

.list-item-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 10rpx;
}

.list-item-desc {
  font-size: 24rpx;
  color: #666;
}

.list-item-arrow {
  color: #999;
  font-size: 24rpx;
}

/* 网格布局 */
.grid {
  display: flex;
  flex-wrap: wrap;
  margin: -10rpx;
}

.grid-item {
  flex: 1;
  min-width: 0;
  padding: 10rpx;
  box-sizing: border-box;
}

.grid-2 .grid-item {
  flex: 0 0 50%;
}

.grid-3 .grid-item {
  flex: 0 0 33.333%;
}

.grid-4 .grid-item {
  flex: 0 0 25%;
}

/* 统计卡片 */
.stat-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 20rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
}

.stat-trend {
  font-size: 20rpx;
  margin-top: 10rpx;
}

.stat-trend.up {
  color: #28a745;
}

.stat-trend.down {
  color: #dc3545;
}

/* 得分显示 */
.score-display {
  text-align: center;
  padding: 40rpx;
}

.score-value {
  font-size: 80rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 20rpx;
}

.score-label {
  font-size: 28rpx;
  color: #666;
}

.score-detail {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 进度条 */
.progress {
  width: 100%;
  height: 8rpx;
  background: #e9ecef;
  border-radius: 4rpx;
  overflow: hidden;
  margin: 20rpx 0;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 500;
  margin: 5rpx;
}

.tag-primary {
  background: #e3f2fd;
  color: #1976d2;
}

.tag-success {
  background: #e8f5e8;
  color: #2e7d32;
}

.tag-warning {
  background: #fff3e0;
  color: #f57c00;
}

.tag-danger {
  background: #ffebee;
  color: #d32f2f;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #999;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #ccc;
}

/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.loading-text {
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #666;
}

/* 动画效果 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideIn {
  from {
    transform: translateX(-100%);
  }
  to {
    transform: translateX(0);
  }
}

@keyframes pulse {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
  100% {
    transform: scale(1);
  }
}

.fade-in {
  animation: fadeIn 0.3s ease-out;
}

.slide-in {
  animation: slideIn 0.3s ease-out;
}

.pulse {
  animation: pulse 2s infinite;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .container {
    padding: 15rpx;
  }
  
  .card-header,
  .card-body {
    padding: 20rpx;
  }
  
  .btn {
    padding: 15rpx 30rpx;
    font-size: 26rpx;
  }
  
  .stat-value {
    font-size: 40rpx;
  }
  
  .score-value {
    font-size: 60rpx;
  }
}

/* 深色模式支持 */
@media (prefers-color-scheme: dark) {
  page {
    background-color: #1a1a1a;
    color: #e0e0e0;
  }
  
  .card {
    background: #2d2d2d;
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
  }
  
  .card-header {
    color: #e0e0e0;
    border-bottom-color: #404040;
  }
  
  .input-field {
    background: #2d2d2d;
    border-color: #404040;
    color: #e0e0e0;
  }
  
  .list-item {
    border-bottom-color: #404040;
  }
  
  .stat-card {
    background: #2d2d2d;
  }
}
