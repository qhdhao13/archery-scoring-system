/* 拍照页面样式 */

.container {
  padding: 0;
  background: #000;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 顶部信息栏 */
.header-info {
  background: rgba(0, 0, 0, 0.8);
  padding: 20rpx 30rpx;
  color: #fff;
  position: relative;
  z-index: 10;
}

.target-info {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.target-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 20rpx;
}

.target-spec {
  font-size: 24rpx;
  color: #ccc;
}

.camera-tips {
  text-align: center;
}

.tip-text {
  font-size: 22rpx;
  color: #999;
}

/* 相机预览区域 */
.camera-container {
  flex: 1;
  position: relative;
  overflow: hidden;
}

.camera-preview {
  width: 100%;
  height: 100%;
  position: relative;
}

/* 相机控制按钮 */
.camera-controls {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  z-index: 20;
}

.control-row {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.control-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10rpx);
  transition: all 0.3s ease;
}

.control-btn:active {
  transform: scale(0.9);
  background: rgba(0, 0, 0, 0.8);
}

.control-btn::after {
  border: none;
}

.btn-icon {
  font-size: 32rpx;
  color: #fff;
}

/* 拍摄按钮区域 */
.capture-area {
  position: absolute;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 20;
}

.capture-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  border: 4rpx solid #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.capture-btn:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.5);
}

.capture-btn::after {
  border: none;
}

.capture-inner {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #fff;
  transition: all 0.3s ease;
}

.capture-btn:active .capture-inner {
  transform: scale(0.8);
}

.capture-hint {
  color: #fff;
  font-size: 24rpx;
  margin-top: 20rpx;
  text-align: center;
}

/* 靶纸类型选择 */
.target-selector {
  background: rgba(0, 0, 0, 0.8);
  padding: 20rpx 0;
  position: relative;
  z-index: 10;
}

.target-scroll {
  white-space: nowrap;
}

.target-options {
  display: inline-flex;
  gap: 20rpx;
  padding: 0 30rpx;
}

.target-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 30rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
  min-width: 120rpx;
}

.target-option.active {
  background: rgba(102, 126, 234, 0.3);
  border-color: #667eea;
}

.target-option:active {
  transform: scale(0.95);
}

.option-distance {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 5rpx;
}

.option-diameter {
  font-size: 20rpx;
  color: #ccc;
}

/* 拍摄历史 */
.recent-photos {
  background: rgba(0, 0, 0, 0.8);
  padding: 20rpx 0;
  position: relative;
  z-index: 10;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.section-action {
  font-size: 24rpx;
  color: #667eea;
}

.photos-scroll {
  white-space: nowrap;
}

.photos-list {
  display: inline-flex;
  gap: 20rpx;
  padding: 0 30rpx;
}

.photo-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.3s ease;
}

.photo-item:active {
  transform: scale(0.95);
}

.photo-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.photo-info {
  margin-top: 10rpx;
  text-align: center;
}

.photo-score {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 5rpx;
}

.photo-time {
  display: block;
  font-size: 20rpx;
  color: #ccc;
}

/* 快速操作 */
.quick-actions {
  display: flex;
  justify-content: space-around;
  background: rgba(0, 0, 0, 0.8);
  padding: 30rpx;
  position: relative;
  z-index: 10;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  border: none;
  color: #fff;
  transition: all 0.3s ease;
}

.action-btn:active {
  transform: scale(0.9);
}

.action-btn::after {
  border: none;
}

.action-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.action-text {
  font-size: 22rpx;
  color: #ccc;
}

/* 拍摄引导弹窗 */
.guide-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 40rpx;
}

.guide-content {
  background: #fff;
  border-radius: 20rpx;
  max-width: 600rpx;
  width: 100%;
  max-height: 80vh;
  overflow: hidden;
}

.guide-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.guide-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
}

.guide-close {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f0f0f0;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #666;
}

.guide-close::after {
  border: none;
}

.guide-body {
  padding: 30rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.guide-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.guide-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  margin-top: 5rpx;
}

.guide-text {
  flex: 1;
}

.guide-step {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 8rpx;
}

.guide-desc {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.guide-footer {
  padding: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

/* 加载提示 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.loading-content {
  background: #fff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
  max-width: 400rpx;
  width: 90%;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto 30rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.loading-progress {
  display: block;
  font-size: 24rpx;
  color: #999;
}

/* 处理结果预览 */
.result-preview {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.9);
  display: flex;
  flex-direction: column;
  z-index: 3000;
}

.preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: rgba(0, 0, 0, 0.8);
  color: #fff;
}

.preview-title {
  font-size: 32rpx;
  font-weight: 600;
}

.preview-close {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #fff;
}

.preview-close::after {
  border: none;
}

.preview-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.preview-image {
  width: 100%;
  max-width: 600rpx;
  height: 400rpx;
  border-radius: 16rpx;
  margin-bottom: 40rpx;
}

.preview-scores {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.score-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  min-width: 100rpx;
}

.score-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 5rpx;
}

.score-label {
  font-size: 20rpx;
  color: #ccc;
}

.preview-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  background: rgba(0, 0, 0, 0.8);
}

.preview-footer .btn {
  flex: 1;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .header-info {
    padding: 15rpx 20rpx;
  }
  
  .target-name {
    font-size: 28rpx;
  }
  
  .target-spec {
    font-size: 22rpx;
  }
  
  .tip-text {
    font-size: 20rpx;
  }
  
  .camera-controls {
    top: 20rpx;
    right: 20rpx;
  }
  
  .control-btn {
    width: 60rpx;
    height: 60rpx;
  }
  
  .btn-icon {
    font-size: 28rpx;
  }
  
  .capture-btn {
    width: 100rpx;
    height: 100rpx;
  }
  
  .capture-inner {
    width: 60rpx;
    height: 60rpx;
  }
  
  .target-options {
    padding: 0 20rpx;
  }
  
  .target-option {
    padding: 15rpx 25rpx;
    min-width: 100rpx;
  }
  
  .option-distance {
    font-size: 24rpx;
  }
  
  .option-diameter {
    font-size: 18rpx;
  }
  
  .photos-list {
    padding: 0 20rpx;
  }
  
  .photo-thumb {
    width: 100rpx;
    height: 100rpx;
  }
  
  .quick-actions {
    padding: 20rpx;
  }
  
  .action-icon {
    font-size: 36rpx;
  }
  
  .action-text {
    font-size: 20rpx;
  }
}
